# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Supabase PostgreSQL connection (required for this branch)
# Get these from: Supabase Dashboard → Settings → Database → Connection string
SUPABASE_HOST=aws-0-us-east-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.your-project-ref
SUPABASE_PASSWORD=your-database-password
